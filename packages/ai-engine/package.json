{
  "name": "@corvus/ai-engine",
  "version": "0.26.1",
  "license": "MPL-2.0",
  "description": "Corvus AI search engine: retrievers (SearXNG/Brave/DuckDuckGo), grounded answers via Anthropic API or local Claude Code CLI, cache.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "corvus-search": "bin/corvus-search.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@corvus/shared": "workspace:*",
    "@mozilla/readability": "0.6.0",
    "franc-min": "6.2.0",
    "linkedom": "0.18.13"
  },
  "devDependencies": {
    "@corvus/ai-engine": "link:.",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
