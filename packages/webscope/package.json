{
  "name": "@corvus/webscope",
  "version": "0.21.1",
  "license": "MPL-2.0",
  "description": "Corvus Webscope: web-traffic security/diagnostics engine (scope, HTTP history, repeater, intruder-style fuzzer, match/replace, encoders, HAR) for authorized testing of your own/permitted targets.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@corvus/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "private": true
}
