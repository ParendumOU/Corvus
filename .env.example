# AI provider: "anthropic-api" (default) or "claude-code-cli" (uses your local Claude Code login; personal use only)
CORVUS_AI_PROVIDER=anthropic-api
ANTHROPIC_API_KEY=
CORVUS_AI_MODEL=claude-haiku-5-5

# Retrieval backend: "searxng" (self-hosted, default), "brave" or "duckduckgo"
CORVUS_RETRIEVER=searxng
CORVUS_SEARXNG_URL=http://localhost:8898
CORVUS_SEARXNG_HOST_PORT=8898
BRAVE_SEARCH_API_KEY=

# Sync server
CORVUS_SYNC_URL=http://localhost:8797
CORVUS_SYNC_HOST_PORT=8797

# Auto-update (electron-updater). Blank URL = GitHub Releases of ParendumOU/Corvus (default).
# A URL switches to a self-hosted electron-builder "generic" feed. Channel: "stable" or "beta".
# Never point this at a domain you do not control.
CORVUS_UPDATE_FEED_URL=
CORVUS_UPDATE_CHANNEL=stable
