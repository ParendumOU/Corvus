  },
  "devDependencies": {
    "@corvus/shared": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
