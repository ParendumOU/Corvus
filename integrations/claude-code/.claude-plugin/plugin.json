{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "corvus",
  "displayName": "Corvus Browser",
  "version": "0.3.0",
  "description": "Drive the Corvus browser from Claude Code: open tabs, read and extract pages, click, type, fill forms, screenshot, and search, in your own logged-in session.",
  "author": { "name": "Parendum", "url": "https://parendum.com" },
  "repository": "https://github.com/ParendumOU/Corvus",
  "keywords": ["browser", "automation", "mcp", "corvus", "web"],
  "mcpServers": {
    "corvus": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/corvus-mcp-stdio.mjs"]
    }
  }
}
