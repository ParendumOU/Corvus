{
  "expo": {
    "name": "Corvus",
    "slug": "corvus-mobile",
    "version": "0.4.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "corvus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.parendum.corvus.mobile",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.parendum.corvus.mobile",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#1B1830",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B1830",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Corvus uses the camera to scan the pairing code that Corvus shows on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["text/plain"]
          }
        }
      ],
      ["expo-notifications", { "color": "#5B5BD6", "icon": "./assets/images/notification-icon.png" }],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
