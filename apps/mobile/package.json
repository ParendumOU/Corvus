{
  "name": "@corvus/mobile",
  "version": "0.6.0",
  "private": true,
  "license": "MPL-2.0",
  "description": "Corvus companion app for Android and iOS: your computer's Corvus in your pocket, over end-to-end encrypted sync.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:web": "expo export --platform web --output-dir dist-web",
    "smoke:web": "node scripts/web-smoke.mjs"
  },
  "dependencies": {
    "@corvus/shared": "workspace:*",
    "@corvus/sync-core": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "buffer": "6.0.3",
    "expo": "~58.0.19",
    "expo-background-task": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "electron": "44.9.0",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-camera"
        ]
      }
    }
  }
}
