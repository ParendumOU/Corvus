diff --git a/android/src/main/java/com/reactnativecommunity/webview/RNCWebViewHooks.java b/android/src/main/java/com/reactnativecommunity/webview/RNCWebViewHooks.java
new file mode 100644
index 0000000..4733c32
--- /dev/null
+++ b/android/src/main/java/com/reactnativecommunity/webview/RNCWebViewHooks.java
@@ -0,0 +1,44 @@
+package com.reactnativecommunity.webview;
+
+import android.webkit.PermissionRequest;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebResourceResponse;
+import android.webkit.WebView;
+
+import androidx.annotation.Nullable;
+
+/**
+ * Corvus: hooks an app module sets once, so it can set up each new WebView, block subresource
+ * requests (ad and tracker blocking), handle navigations to other apps' schemes itself and answer
+ * the pages' camera and microphone requests, without its own copy of the WebView component. Unset
+ * hooks change nothing.
+ */
+public final class RNCWebViewHooks {
+    private RNCWebViewHooks() {}
+
+    public interface RequestInterceptor {
+        /** A response to use instead of the network (an empty one blocks), or null to load it. Runs off the main thread. */
+        @Nullable
+        WebResourceResponse intercept(WebView view, WebResourceRequest request);
+    }
+
+    public interface NavigationHandler {
+        /** True when the app took the navigation over: the WebView does not load it. */
+        boolean override(WebView view, WebResourceRequest request);
+    }
+
+    public interface PermissionHandler {
+        /** True when the app answered (granted or denied) the page's request itself. */
+        boolean handle(WebView view, PermissionRequest request);
+    }
+
+    public interface ViewConfigurer {
+        /** Called once for each new WebView, before it loads anything. */
+        void configure(WebView view);
+    }
+
+    public static volatile @Nullable ViewConfigurer viewConfigurer;
+    public static volatile @Nullable RequestInterceptor requestInterceptor;
+    public static volatile @Nullable NavigationHandler navigationHandler;
+    public static volatile @Nullable PermissionHandler permissionHandler;
+}
